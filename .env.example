# Neon Postgres (see README -> "Going live"). DATABASE_URL is the pooled
# connection string; DIRECT_URL is the direct one (Prisma CLI / migrations).
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# Local-only escape hatch: set to 1 when this network breaks the Neon
# driver's WebSocket (queries then go over HTTPS; no transactions).
# NEON_FETCH_MODE=1

# Owner login (see README -> "Owner login"). Generate the hash + secret with:
#   npx tsx scripts/hash-password.ts
OWNER_EMAIL=
OWNER_PASSWORD_HASH=
AUTH_SECRET=

# Vercel Cron: secret Vercel sends as a Bearer token to /api/cron/prices.
CRON_SECRET=
